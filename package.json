{
  "name": "@cognitive-fab/polyx",
  "version": "0.1.0",
  "type": "module",
  "description": "Mine the rules a customer-service agent's own history supports, and serve them back with abstention.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitive-fab/polyx.git"
  },
  "homepage": "https://github.com/cognitive-fab/polyx#readme",
  "keywords": [
    "agents",
    "process-mining",
    "declare",
    "rules",
    "abstention",
    "claude-code",
    "governance"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "polyx": "bin/polyx.mjs"
  },
  "files": [
    "bin",
    "dist/src",
    "src",
    "examples",
    "polyx.config.json",
    "LICENSE",
    "LICENSING.md",
    "NOTICE",
    "licenses",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --no-warnings --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check:boundary": "node --no-warnings scripts/check-boundary.mjs",
    "check:notice": "node --no-warnings scripts/check-notice.mjs",
    "ci": "npm run typecheck && npm run check:boundary && npm run check:notice && npm run check:shippable && npm test",
    "check:shippable": "node --no-warnings scripts/check-shippable.mjs",
    "prepare": "npm run build"
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@cognitive-fab/polyx-lens": "^0.2.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
